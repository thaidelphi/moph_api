# ==========================================
# fpsso Configuration Example (.env)
# ==========================================

# Database Connection Settings (ตั้งค่าการเชื่อมต่อฐานข้อมูล MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=your_db_password
DB_NAME=radius

# ThaID OAuth2 Settings (กรมการปกครอง)
THAID_CLIENT_ID=your_thaid_client_id
THAID_SECRET_ID=your_thaid_secret_id
# URL ปกติของระบบ: https://api.yourdomain.com/sso/auth/thaid/callback
# หรือหากใช้แทน PHP เดิม: https://api.yourdomain.com/thaid_api.php
THAID_REDIRECT_URI=https://api.yourdomain.com/sso/auth/thaid/callback
THAID_URL_TOKEN=https://imauth.bora.dopa.go.th/api/v2/oauth2/token/
THAID_URL_AUTH=https://imauth.bora.dopa.go.th/api/v2/oauth2/auth/
THAID_SCOPE=pid name address

# MOPH Provider ID Settings (กระทรวงสาธารณสุข)
PROVIDER_ID_CLIENT_ID=your_providerid_client_id
PROVIDER_ID_SECRET_KEY=your_providerid_secret_key
# URL ปกติของระบบ: https://api.yourdomain.com/sso/auth/providerid/callback
# หรือหากใช้แทน PHP เดิม: https://api.yourdomain.com/providerid_api.php
PROVIDER_ID_REDIRECT_URI=https://api.yourdomain.com/sso/auth/providerid/callback
PROVIDER_ID_URL=https://provider.id.th

# Google OAuth 2.0 Settings
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# URL ปกติของระบบ: https://api.yourdomain.com/sso/auth/google/callback
# หรือหากใช้แทน PHP เดิม: https://api.yourdomain.com/google_api.php
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/sso/auth/google/callback
GOOGLE_URL_AUTH=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_URL_TOKEN=https://oauth2.googleapis.com/token
GOOGLE_URL_USERINFO=https://www.googleapis.com/oauth2/v3/userinfo

# System & Application Settings (ตั้งค่าระบบและ Admin)
LOGIN_TEMPLATE_PATH=templates/login.html
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
SSO_AUTO_APPROVE=true
APP_PORT=8080

# FortiGate Integration Settings
FORTIGATE_LOGOUT_URL=

# License Configuration (ระบุ path ไปยังไฟล์ license.key)
# ค่าเริ่มต้น: license.key (อยู่ข้าง fpsso binary)
# รัน ./fpsso --hwid เพื่อดู Machine ID สำหรับขอ License
LICENSE_KEY=license.key

# SSL Configuration (ตั้งค่าการใช้งาน HTTPS โดยตรงโดยไม่ผ่าน Apache)
# หากคุณใช้ Apache/Nginx เป็น Reverse Proxy (พอร์ต 443) อยู่แล้ว ให้ตั้ง USE_SSL=false
USE_SSL=false
SSL_CERT=cert.pem
SSL_KEY=key.pem
