# ==============================================================================
#                 ไฟล์ตัวอย่างการตั้งค่าระบบ fpsso (.env.example)
# ==============================================================================
# คำแนะนำ: คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามสภาพแวดล้อมของคุณ:
#          cp .env.example .env
# หลังจากแก้ไขค่าใน .env ให้รีสตาร์ท Service เสมอด้วย:
#          sudo systemctl restart fpsso
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. การเชื่อมต่อฐานข้อมูล MySQL / MariaDB (Database Settings)
# ------------------------------------------------------------------------------
# DB_HOST : หมายเลข IP หรือ Hostname ของเซิร์ฟเวอร์ MySQL (เช่น 127.0.0.1)
DB_HOST=127.0.0.1

# DB_USER : ชื่อผู้ใช้งานฐานข้อมูลที่มีสิทธิ์จัดการตาราง radcheck, radcheck_mirror, login_history
DB_USER=radius_user

# DB_PASS : รหัสผ่านสำหรับเข้าใช้งานฐานข้อมูล
DB_PASS=your_db_password

# DB_NAME : ชื่อฐานข้อมูลหลักของระบบ RADIUS (ค่าเริ่มต้น: radius)
DB_NAME=radius


# ------------------------------------------------------------------------------
# 2. การตั้งค่าระบบยืนยันตัวตน ThaID (กรมการปกครอง - DOPA)
# ------------------------------------------------------------------------------
# THAID_API_KEY : คีย์ API Key สำหรับส่งใน Header (x-api-key) ของระบบ ThaID API v2
THAID_API_KEY=your_thaid_api_key

# THAID_CLIENT_ID : รหัส Client ID ที่ได้จากการลงทะเบียนแอปพลิเคชันกับสำนักบริหารการทะเบียน (DOPA)
THAID_CLIENT_ID=your_thaid_client_id

# THAID_SECRET_ID : รหัส Secret Key คู่กับ Client ID จาก DOPA
THAID_SECRET_ID=your_thaid_secret_key

# THAID_REDIRECT_URI : URL ปลายทางที่ ThaID จะส่งข้อมูลกลับมา (ต้องตรงกับที่ลงทะเบียนไว้กับ DOPA ทุกตัวอักษร)
THAID_REDIRECT_URI=https://auth.yourdomain.com/sso/auth/thaid/callback

# THAID_URL_TOKEN : Endpoint สำหรับขอรับ Access Token และข้อมูลผู้ใช้
THAID_URL_TOKEN=https://imauth.bora.dopa.go.th/api/v2/oauth2/token/

# THAID_URL_AUTH : Endpoint หน้าแสดง QR Code ให้ผู้ใช้สแกนผ่านแอป ThaID บนมือถือ
THAID_URL_AUTH=https://imauth.bora.dopa.go.th/api/v2/oauth2/auth/

# THAID_SCOPE : ขอบเขตข้อมูลที่ต้องการขอจาก ThaID (คั่นด้วยวรรค เช่น pid name address)
#   - pid     : เลขประจำตัวประชาชน 13 หลัก
#   - name    : ชื่อและนามสกุลภาษาไทย
#   - address : ที่อยู่ตามทะเบียนบ้าน
THAID_SCOPE=pid name address


# ------------------------------------------------------------------------------
# 3. การตั้งค่าระบบยืนยันตัวตน Provider ID / MOPH ID (กระทรวงสาธารณสุข)
# ------------------------------------------------------------------------------
# MOPH_ID_URL : URL ระบบ MOPH ID
MOPH_ID_URL=https://moph.id.th

# PROVIDER_ID_URL : URL ระบบยืนยันตัวตนบุคลากรสาธารณสุข Provider ID
PROVIDER_ID_URL=https://provider.id.th

# MOPH_ID_CLIENT_ID & SECRET : คีย์สำหรับ MOPH ID (กรณีเปิดใช้งาน)
MOPH_ID_CLIENT_ID=your_moph_id_client_id
MOPH_ID_SECRET_KEY=your_moph_id_secret_key

# PROVIDER_ID_CLIENT_ID & SECRET : คีย์ Client ID และ Secret Key ที่ได้รับจาก Provider ID
PROVIDER_ID_CLIENT_ID=your_provider_id_client_id
PROVIDER_ID_SECRET_KEY=your_provider_id_secret_key

# PROVIDER_ID_REDIRECT_URI : Callback URL สำหรับรับผลการยืนยันตัวตน Provider ID
PROVIDER_ID_REDIRECT_URI=https://auth.yourdomain.com/sso/auth/providerid/callback


# ------------------------------------------------------------------------------
# 4. การตั้งค่าระบบยืนยันตัวตน Google OAuth 2.0 (Google Sign-In)
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID : Client ID จาก Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# GOOGLE_CLIENT_SECRET : Client Secret จาก Google Cloud Console
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GOOGLE_REDIRECT_URI : Callback URL ที่ระบุไว้ใน Google Cloud Console
GOOGLE_REDIRECT_URI=https://auth.yourdomain.com/sso/auth/google/callback

# Google OAuth Endpoints (มาตรฐานของ Google ไม่จำเป็นต้องแก้ไข)
GOOGLE_URL_AUTH=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_URL_TOKEN=https://oauth2.googleapis.com/token
GOOGLE_URL_USERINFO=https://www.googleapis.com/oauth2/v3/userinfo


# ------------------------------------------------------------------------------
# 5. การตั้งค่าเชื่อมต่อกับ FortiGate Captive Portal
# ------------------------------------------------------------------------------
# FORTIGATE_AUTH_URL : URL หน้า Authen บน Interface ขา Gateway ของ FortiGate ที่รับข้อมูล Handshake
FORTIGATE_AUTH_URL=http://192.168.200.1:1000/fgtauth

# FORTIGATE_LOGOUT_URL : URL สำหรับสั่งตัดการเชื่อมต่ออินเทอร์เน็ตบน FortiGate
FORTIGATE_LOGOUT_URL=http://192.168.200.1:1000/logout?

# FORTIGATE_API_TOKEN : REST API Token ของ FortiGate (กรณีต้องการดู Monitor ผู้ใช้งานแบบเรียลไทม์)
#FORTIGATE_API_TOKEN=your_fortigate_api_token

# FORTIGATE_API_URL : URL REST API Endpoint ของ FortiGate
#FORTIGATE_API_URL=https://192.168.200.1/api/v2/monitor/user/firewall/select


# ------------------------------------------------------------------------------
# 6. การตั้งค่าเซิร์ฟเวอร์และแอปพลิเคชัน (Application & System Settings)
# ------------------------------------------------------------------------------
# APP_PORT : พอร์ตที่โปรแกรม fpsso เปิดรับคำขอจาก Reverse Proxy (Apache ส่งต่อมาที่พอร์ตนี้)
APP_PORT=8080

# APP_URL : Base URL โดเมนหลักแบบ HTTPS ของระบบ (ใช้สำหรับสร้าง URL ปลายทางหลังล็อกอิน)
APP_URL=https://auth.yourdomain.com

# POST_LOGIN_REDIRECT_URL : หน้าปลายทางหลังล็อกอินสำเร็จ (เช่น /sso/status หรือ https://google.com)
POST_LOGIN_REDIRECT_URL=/sso/status

# SSO_AUTO_APPROVE : การอนุมัติสิทธิ์ใช้งานอินเทอร์เน็ตอัตโนมัติ
#   - true  : เมื่อผู้ใช้ยืนยันตัวตนผ่าน ThaID/Google/ProviderID สำเร็จ จะใช้งานอินเทอร์เน็ตได้ทันที
#   - false : ผู้ใช้ต้องรอให้ผู้ดูแลระบบอนุมัติบัญชีในหน้า Admin ก่อน จึงจะใช้งานได้
SSO_AUTO_APPROVE=true

# ENABLE_LOGOUT_POPUP : เปิด/ปิดการเด้งหน้าต่าง Logout ขนาดเล็ก (แนะนำ false เพื่อไม่ให้เปิดหลายแท็บ)
#ENABLE_LOGOUT_POPUP=false

# RADIUS_SECRET : Shared Secret สำหรับ FreeRADIUS (ตรงกับใน clients.conf)
RADIUS_SECRET=your_radius_secret

# LOGIN_TEMPLATE_PATH : ตำแหน่งไฟล์หน้าเว็บ Login กำหนดเอง (หากเว้นว่างไว้จะใช้ templates/login.html)
#LOGIN_TEMPLATE_PATH=templates/login.html

# LICENSE_KEY : ที่อยู่ของไฟล์ License Key (ค่าเริ่มต้น: license.key)
LICENSE_KEY=license.key


# ------------------------------------------------------------------------------
# 7. บัญชีผู้ดูแลระบบ (Admin Dashboard Settings)
# ------------------------------------------------------------------------------
# เข้าจัดการผู้ใช้งานและดูรายงานได้ที่: https://auth.yourdomain.com/sso/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password


# ------------------------------------------------------------------------------
# 8. การตั้งค่า SSL / HTTPS ในตัวโปรแกรม (Native SSL Settings)
# ------------------------------------------------------------------------------
# USE_SSL : หากใช้งานผ่าน Apache/Nginx Reverse Proxy (พอร์ต 443) อยู่แล้ว ให้ตั้งเป็น false
USE_SSL=false
SSL_CERT=cert.pem
SSL_KEY=key.pem
