# ==========================================
# fp-radius Configuration Example (.env)
# ==========================================

# Database Connection Settings (ตั้งค่าการเชื่อมต่อฐานข้อมูล MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password
DB_NAME=radius

# RADIUS Server Settings (ตั้งค่าการทำงานของ RADIUS Server)
# Shared Secret ต้องตรงกับค่าที่ตั้งไว้บน FortiGate หรืออุปกรณ์ Network
RADIUS_SECRET=testing123
RADIUS_PORT=1812
RADIUS_ACCT_PORT=1813

# Logging Settings (ตั้งค่า Log)
# RADIUS_LOG_LEVEL: 0 = Error เท่านั้น, 1 = Info (ทั่วไป), 2 = Debug (ละเอียด)
RADIUS_LOG_FILE=/var/log/fp-radius.log
RADIUS_LOG_LEVEL=1
